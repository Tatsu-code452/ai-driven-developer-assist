PORT=8080
# 管理データの保存先(workspace.json と projects/<案件ID>/ が作られる)
DATA_DIR=./data
# メモリに常駐させる案件データの上限(超えると最近使っていない案件から手放す)
MAX_LOADED_PROJECTS=20
# 監査ログの切り替えサイズ(byte)と、旧世代を残す数(0なら削除しない)
AUDIT_MAX_BYTES=5242880
AUDIT_KEEP_FILES=10
# Git操作を許可する作業ディレクトリのルート。この配下のみ操作できる
GIT_WORKSPACE_ROOT=./workspaces
CORS_ORIGIN=http://localhost:5173
# 設定すると /api/health 以外は "Authorization: Bearer <token>" が必須になる
API_TOKEN=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Copilot / GitHub Copilot は OpenAI互換 chat/completions のエンドポイントを指定する
COPILOT_API_URL=
COPILOT_API_KEY=
COPILOT_MODEL=
GITHUB_COPILOT_API_URL=
GITHUB_COPILOT_API_KEY=
GITHUB_COPILOT_MODEL=
